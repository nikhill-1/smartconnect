# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL with pgvector)
# Format: postgres://username:password@localhost:5432/smartconnect_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartconnect_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=smartconnect_db
PGUSER=postgres
PGPASSWORD=postgres

# AI Services Configuration
# Supported LLM providers: gemini, openai, mock
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI (Alternative option)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Admin Security & Auth
JWT_SECRET=trr_smartconnect_jwt_secret_key_change_in_production_2024
ADMIN_USERNAME=12345
# Default admin password hash for initial setup (or password verified on server)
ADMIN_PASSWORD=admin
ADMIN_SESSION_EXPIRES_IN=24h

# RAG Thresholds
RELEVANCE_THRESHOLD=0.55
TOP_K_CHUNKS=4
MAX_REQUEST_CHAR_LENGTH=1000
RATE_LIMIT_MAX_PER_MINUTE=60
