# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL with optional pgvector)
# Format: postgresql://username:password@localhost:5432/smartconnect_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartconnect_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=smartconnect_db
PGUSER=postgres
PGPASSWORD=postgres

# Google Gemini AI Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_MAX_OUTPUT_TOKENS=900

# Alternative: OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Security & Authentication
JWT_SECRET=trr_smartconnect_jwt_secret_key_change_in_production_2024
ADMIN_USERNAME=12345
ADMIN_PASSWORD=admin
ADMIN_SESSION_EXPIRES_IN=24h

# Student Portal Configuration
STUDENT_SESSION_EXPIRES_IN=12h
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Circulars & Upload Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
CIRCULAR_SYNC_INTERVAL_MINUTES=10

# RAG Engine Parameters
RELEVANCE_THRESHOLD=0.35
TOP_K_CHUNKS=4
MAX_REQUEST_CHAR_LENGTH=1000
RATE_LIMIT_MAX_PER_MINUTE=60
